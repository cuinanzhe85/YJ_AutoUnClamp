<Window x:Class="YJ_AutoUnClamp.Views.Popup_View.ModelChange_View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YJ_AutoUnClamp"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        mc:Ignorable="d"
        xmlns:utils="clr-namespace:YJ_AutoUnClamp.Utils"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        utils:WindowBlur.IsEnabled="True"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Name="Model" Width="500" Height="550">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.08*"/>
            <RowDefinition Height="0.92*"/>
        </Grid.RowDefinitions>
        <!-- 반투명 배경 -->
        <Border Grid.RowSpan="2" Background="Black" Opacity="0.6"/>
        <!-- 타이틀 -->
        <Grid>
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="MouseDown">
                    <b:InvokeCommandAction Command="{Binding Source={x:Static utils:WindowManager.Instance}, Path=MoveCommand}" 
                                   CommandParameter="Model"/>
                </b:EventTrigger>
            </b:Interaction.Triggers>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#261b2a" Offset="0.0"/>
                    <GradientStop Color="#292d37" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel Orientation="Horizontal">
                <telerik:RadGlyph Glyph="&#xe13b;" Margin="15,0" FontSize="24" Foreground="White"/>
                <Label Content="Model Change" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalContentAlignment="Center"/>
            </StackPanel>
            <telerik:RadButton Style="{StaticResource Exit_ButtonStyle}"
                       Command="{Binding Source={x:Static utils:WindowManager.Instance}, Path=CloseCommand}" 
                       CommandParameter="Model">
                <telerik:RadGlyph Glyph="&#xe11b;" FontSize="24"/>
            </telerik:RadButton>
        </Grid>
        <Grid Grid.Row="1">
            <!-- 모델 리스트 -->
            <Grid Background="#F9F8F9" Margin="20" telerik:CornerRadiusHelper.ClipRadius="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.1*"/>
                    <RowDefinition Height="0.65*"/>
                    <RowDefinition Height="0.1*"/>
                    <RowDefinition Height="0.15*"/>
                </Grid.RowDefinitions>
                <Label Content="Model List" FontSize="15" FontWeight="SemiBold" Padding="10,0,0,0" VerticalAlignment="Center"/>
                <telerik:RadListBox Grid.Row="1" Background="White" Margin="10,0,10,10" FontSize="20"
                            SelectedIndex="{Binding SelectedFilelIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            SelectedValue="{Binding SelectedFileNmae, Mode=TwoWay}"
                            ItemsSource="{Binding ModelList, UpdateSourceTrigger=PropertyChanged}"
                            telerik:StyleManager.Theme="Material"/>
                <Grid Grid.Row="2" Grid.ColumnSpan="2" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="0.2*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Background="White" Margin="10,2,2,5" FontSize="16" FontWeight="SemiBold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Text="{Binding SelectedFileNmae, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    <Button Content="Create" Grid.Column="1" Style="{StaticResource ModelData_ButtonStyle}" Margin="0,0,10,5"
                            Command="{Binding ModelNewDelete_Command}" CommandParameter="New"/>
                </Grid>
                <UniformGrid Grid.Row="3" Rows="1" Columns="2" Margin="10,0,10,10">
                    <Button Content="Delete" Style="{StaticResource ModelData_ButtonStyle}" Margin="0,2.5,5,0" Background="PaleVioletRed"
                            Command="{Binding ModelNewDelete_Command}" CommandParameter="Delete"/>
                    <Button Content="Model Change" Style="{StaticResource ModelData_ButtonStyle}" Margin="5,2.5,0,0" Background="Green"
                            Command="{Binding ModelChange_Command}"/>
                </UniformGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>
